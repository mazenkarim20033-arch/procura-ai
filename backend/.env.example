# Copy to .env (git-ignored). Never commit real values.
APP_ENV=dev
LOG_LEVEL=INFO

# Supabase: Project > Connect > Session pooler connection string
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres

# AI. "mock" = recorded demo responses, no credentials needed (clearly labelled in the UI).
LLM_PROVIDER=mock
# For Groq (OpenAI-compatible):
# LLM_PROVIDER=openai_compat
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=
# LLM_MODEL=
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
