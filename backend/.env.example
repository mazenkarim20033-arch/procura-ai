# Copy to .env (git-ignored). Never commit real values.
APP_ENV=dev
LOG_LEVEL=INFO

# Supabase: Project > Connect > Session pooler connection string
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres

# AI. "mock" = recorded demo responses, no credentials needed (clearly labelled in the UI).
LLM_PROVIDER=mock
# For Groq (OpenAI-compatible; base URL defaults to https://api.groq.com/openai/v1):
# LLM_PROVIDER=groq
# LLM_API_KEY=
# LLM_MODEL=
# Optional, to estimate cost per assessment (USD per million tokens; none are assumed):
# LLM_PRICE_IN_PER_M=
# LLM_PRICE_OUT_PER_M=
# Changing the model requires re-indexing (POST /policies/reindex) and re-tuning RELEVANCE_MIN_SIMILARITY.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_CACHE_DIR=C:/path/to/model-cache   # default is the OS temp dir, which can be cleaned
